# Auto detect text files and perform LF normalization
* text=auto

# the windows installer reads this file verbatim: NSIS needs CRLF and the
# UTF-8 BOM to render the liability page correctly.
build/windows/installer/disclaimer.txt text eol=crlf

# the translation tables are strings, not code, so they stay out of github's
# language stats. the wails bindings are written by `make bindings`.
frontend/src/lib/locales/*.ts linguist-detectable=false
frontend/bindings/** linguist-generated
