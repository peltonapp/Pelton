    "RVERB": ["send", "resend", "send over", "forward", "share", "email", "e-mail", "get back to me", "get back to us", "follow up", "check", "double-check", "look into", "look at", "review", "go through", "go over", "call", "ring", "confirm", "prepare", "draft", "write up", "update", "finish", "complete", "deliver", "ship", "fix", "sort out", "take care of", "handle", "book", "schedule", "arrange", "organize", "organise", "set up", "pay", "transfer", "sign", "countersign", "submit", "provide", "put together", "upload", "publish", "reply", "respond", "answer", "find out", "investigate", "deploy", "approve", "order", "return", "bring", "drop off", "pick up", "print", "add", "ping", "remind", "revise", "edit", "correct", "have a look", "take a look", "fill out", "fill in", "loop in", "introduce", "renew", "cancel", "refund", "check in", "send me", "send us", "let me know", "let us know", "get me", "get us"]
  },
  "commitments": [
    {"re": "\\b(?:i|we)(?:'ll|\\s+will|\\s+shall|'m going to|\\s+am going to|'re going to|\\s+are going to|'m gonna|\\s+am gonna)(?:\\s+{ADV}){0,2}\\s+{VERB}\\b", "conf": 0.75},
    {"re": "\\b(?:i|we)\\s+(?:promise|commit|plan|intend|aim|expect|undertake)\\s+to(?:\\s+{ADV}){0,2}\\s+{VERB}\\b", "conf": 0.75},
    {"re": "\\b(?:i|we)(?:'ll|\\s+will)(?:\\s+{ADV}){0,2}\\s+make sure\\b", "conf": 0.7},
    {"re": "\\b(?:i|we)(?:'ll|\\s+will)\\s+have\\s+(?:it|this|that|them|the\\s+\\w+|my\\s+\\w+|our\\s+\\w+)(?:\\s+\\w+){0,3}?\\s+(?:ready|done|finished|sent|over to you|to you)\\b", "conf": 0.75},
    {"re": "\\blet me(?:\\s+{ADV}){0,2}\\s+(?:check|double-check|look into|look at|find out|confirm|review|ask|get back to you|follow up|sort out|take care of|dig into|have a look|take a look|investigate)\\b", "conf": 0.65},
    {"re": "\\byou(?:'ll|\\s+will)\\s+(?:have|get|receive)\\s+(?:it|this|that|them|the\\s+\\w+|my\\s+\\w+|our\\s+\\w+|an?\\s+\\w+)\\b", "conf": 0.6, "needsDue": true},
    {"re": "\\b(?:it|this|that|they|the(?:\\s+\\w+){1,2}|your(?:\\s+\\w+){1,2})\\s+will\\s+be\\s+(?:sent|shipped|delivered|ready|done|finished|fixed|deployed|released|paid|transferred|signed)\\b", "conf": 0.6, "needsDue": true}
  ],
  "requests": [
    {"re": "\\b(?:can|could|would|will)\\s+you(?:\\s+please)?(?:\\s+{ADV}){0,2}\\s+{RVERB}\\b", "conf": 0.7},
    {"re": "\\b(?:please|pls|kindly)(?:\\s*,)?(?:\\s+{ADV}){0,1}\\s+{RVERB}\\b", "conf": 0.7},
    {"re": "^(?:{RVERB})\\b", "conf": 0.6, "needsDue": true},
    {"re": "\\b(?:i|we)(?:'d|\\s+would|\\s+really|\\s+will|\\s+just)?\\s+(?:need|like|want)\\s+you\\s+to(?:\\s+{ADV}){0,2}\\s+{RVERB}\\b", "conf": 0.7},
    {"re": "\\b(?:i|we)(?:'d|\\s+would|\\s+really|\\s+will|\\s+just)?\\s+need\\s+(?:it|this|that|them|the\\s+\\w+|your\\s+\\w+)(?:\\s+\\w+){0,3}?\\s+(?:by|before|until|no later than)\\b", "conf": 0.65, "needsDue": true},
    {"re": "\\blet (?:me|us) know(?:\\s+\\S+){0,6}?\\s+(?:by|before|until|no later than)\\b", "conf": 0.65, "needsDue": true},
    {"re": "\\bmake sure (?:to|you)\\s+{RVERB}\\b", "conf": 0.6},
    {"re": "\\b(?:don't|do not) forget to\\s+{RVERB}\\b", "conf": 0.65, "allowNegation": true},
    {"re": "\\b(?:can|could|may) (?:i|we) (?:ask|get) you to\\s+{RVERB}\\b", "conf": 0.7},
    {"re": "\\b(?:you|you'll)\\s+(?:need|have)\\s+to\\s+{RVERB}(?:\\s+\\S+){0,6}?\\s+(?:by|before|until|no later than)\\b", "conf": 0.6, "needsDue": true}
  ],
  "negation": "\\b(?:not|never|no longer|unable|won't|wont|can't|cant|cannot|couldn't|wouldn't|don't|didn't|isn't|aren't|wasn't|shan't|nobody|nothing)\\b",
  "conditional": "\\b(?:if|unless|in case|as soon as|once\\s+(?:i|we|you|it|it's|they|he|she|the|this|that|everything|all)|should you|provided that|assuming|depending on|whenever|otherwise)\\b",
  "notConditional": "\\b(?:check|see|ask|find out|verify|look)\\s+if\\b",
