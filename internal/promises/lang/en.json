{
  "lang": "en",
  "dateOrder": "mdy",
  "stopwords": ["the", "and", "you", "to", "is", "will", "with", "for", "this", "that", "have", "be", "on", "it", "of", "in", "we", "i", "can", "please", "thanks", "your", "are", "my", "me", "by", "if", "what", "just", "hi", "hello", "would", "could", "let", "know"],
