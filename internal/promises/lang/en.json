  "habitual": "\\b(?:every|each|always|usually|normally|often|sometimes|generally|typically)\\b",
  "hedge": "\\b(?:try|trying|maybe|perhaps|possibly|probably|hopefully|might|attempt|my best|if possible|not sure|i think|i guess)\\b",
