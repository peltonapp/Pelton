  "cut": [
    "^--\\s*$",
    "^__+\\s*$",
    "^on\\b.{4,200}\\bwrote:\\s*$",
    "^on\\b.{4,120}$\\n^.{0,120}\\bwrote:\\s*$",
    "^-{2,}\\s*original message\\s*-{2,}\\s*$",
    "^-{2,}\\s*forwarded message\\s*-{2,}\\s*$",
    "^begin forwarded message:?\\s*$",
    "^from:\\s.+$\\n^(?:sent|date):\\s.+$",
    "^sent from my \\w+",
    "^get outlook for \\w+"
