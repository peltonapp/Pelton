  "futureCue": "\\b(?:soon|shortly|later|asap|next|tomorrow|today|tonight|this afternoon|this evening)\\b",
  "dates": {
    "weekdays": {"sunday": 0, "monday": 1, "tuesday": 2, "tue": 2, "tues": 2, "wednesday": 3, "wed": 3, "thursday": 4, "thu": 4, "thur": 4, "thurs": 4, "friday": 5, "fri": 5, "saturday": 6},
    "months": {"january": 1, "jan": 1, "february": 2, "feb": 2, "march": 3, "mar": 3, "april": 4, "apr": 4, "may": 5, "june": 6, "jun": 6, "july": 7, "jul": 7, "august": 8, "aug": 8, "september": 9, "sep": 9, "sept": 9, "october": 10, "oct": 10, "november": 11, "nov": 11, "december": 12, "dec": 12},
    "numbers": {"a": 1, "an": 1, "one": 1, "two": 2, "three": 3, "four": 4, "five": 5, "six": 6, "seven": 7, "eight": 8, "nine": 9, "ten": 10, "a couple of": 2, "a few": 3, "couple of": 2},
    "units": {"day": "day", "days": "day", "business day": "bday", "business days": "bday", "working day": "bday", "working days": "bday", "week": "week", "weeks": "week", "month": "month", "months": "month", "hour": "hour", "hours": "hour"},
    "phrases": [
      {"re": "\\b(?:today|tonight|this evening|this afternoon|end of (?:the |my )?day|eod|close of business|cob)\\b", "rel": "today"},
      {"re": "\\b(?:the )?day after tomorrow\\b", "rel": "day", "n": 2},
      {"re": "\\btomorrow\\b", "rel": "day", "n": 1},
      {"re": "\\bend of next week\\b", "rel": "weekend", "n": 1},
      {"re": "\\b(?:end of (?:the |this )?week|eow|this week|later this week)\\b", "rel": "weekend", "n": 0},
      {"re": "\\b(?:early next week|beginning of next week|start of next week)\\b", "rel": "weekstart", "n": 1},
      {"re": "\\bnext week\\b", "rel": "weekend", "n": 1},
      {"re": "\\bend of next month\\b", "rel": "monthend", "n": 1},
      {"re": "\\b(?:end of (?:the |this )?month|eom|this month|later this month)\\b", "rel": "monthend", "n": 0},
      {"re": "\\bnext month\\b", "rel": "monthend", "n": 1},
      {"re": "\\bnext\\s+{WEEKDAY}\\b", "rel": "nextweekday"},
      {"re": "\\b(?:this|this coming|coming)\\s+{WEEKDAY}\\b", "rel": "weekday"},
      {"re": "\\b{WEEKDAY}\\b", "rel": "weekday"},
      {"re": "\\b(?:in|within)\\s+(?:the next\\s+)?{NUMBER}\\s+{UNIT}\\b", "rel": "in"},
      {"re": "\\b{DAY}(?:st|nd|rd|th)?\\s+(?:of\\s+)?{MONTH}\\b(?:,?\\s+{YEAR})?", "rel": "daymonth"},
      {"re": "\\b{MONTH}\\s+{DAY}(?:st|nd|rd|th)?\\b(?:,?\\s+{YEAR})?", "rel": "monthday"}
