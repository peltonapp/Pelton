build/bin
node_modules
frontend/dist

# wails' marker for whether the frontend deps need reinstalling. It is a local
# build cache keyed on package.json, rewritten by every build, so tracking it
# meant a dependency bump left the tree dirty until someone built. Wails writes
# it (and installs) when it is missing, so a fresh clone is unaffected.
frontend/package.json.md5

# Local e2e TLS material (CA and server key). Trust ca.crt on the machine; never commit.
e2e/certs/
# Seed corpus index, timings, and Playwright output. Never commit.
e2e/manifest.json
e2e/report.md
e2e/ui/node_modules/
e2e/ui/test-results/
e2e/ui/playwright-report/
e2e/ui/blob-report/
e2e/.wails.log
e2e/.wails.pid
e2e/.frontend-url

# compiled binaries at repo root
/Pelton
/Pelton.exe

# nix build output symlink(s) (`nix build`, `packaging/nix/package.nix`)
/result
/result-*

.DS_Store

